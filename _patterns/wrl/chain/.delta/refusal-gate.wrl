profile forge.world.core.v1

; REFUSAL GATE — the page is a Door; material must pass rg_sufficiency (a relay, and a router) to open it.
; rg_in is the entry, fed by the evidence router.
[relay:rg_in]{sig_in, sig_out}
[relay:rg_sufficiency]{sig_in, sig_out}
[door:rg_page]{sig_in}

[rg_in] --sig--> [rg_sufficiency]
[rg_sufficiency] --sig--> [rg_page]

; TEST BENCH — drives this chapter's entry alone; the chain replaces it with a wire from an earlier chapter
[pulser:rg_bench](every 1){sig_out}
[rg_bench] --sig--> [rg_in]
