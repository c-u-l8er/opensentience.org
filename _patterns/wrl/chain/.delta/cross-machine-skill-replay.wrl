profile forge.world.core.v1

; CROSS-MACHINE SKILL REPLAY — one signal, two machines (replicated relays), two doors that open at the same
; epoch. cx_in is the entry; the machines are `*2`; cx_machine0 routes on to Part V.
[relay:cx_in]{sig_in, sig_out}
[relay:cx_machine*2]{sig_in, sig_out}
[door:cx_replay*2]{sig_in}

[cx_in] --sig--> {[cx_machine0], [cx_machine1]}
[cx_machine0] --sig--> [cx_replay0]
[cx_machine1] --sig--> [cx_replay1]

; TEST BENCH — drives this chapter's entry alone; the chain replaces it with a wire from an earlier chapter
[pulser:cx_bench](every 1){sig_out}
[cx_bench] --sig--> [cx_in]
