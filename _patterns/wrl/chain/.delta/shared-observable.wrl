profile forge.world.core.v1

; SHARED OBSERVABLE — the rotor determines the pose and is in the Film; a numeric fault on the orb is seeded
; as INITIAL runtime state and healed by ResetFault at epoch 3. so_in is the entry, fed by Part II's router.
[relay:so_in]{sig_in, sig_out}
[spinner:so_rotor](w=16, n=8, rotor=quarter_turn_z, configurable){sig_in, socket}
[orb:so_pose]{pose}

[so_in] --sig--> [so_rotor]
[so_rotor] --socket--> [so_pose]

; TEST BENCH — drives this chapter's entry alone; the chain replaces it with a wire from an earlier chapter
[pulser:so_bench](every 1){sig_out}
[so_bench] --sig--> [so_in]
