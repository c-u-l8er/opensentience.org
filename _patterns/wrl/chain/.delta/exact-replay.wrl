profile forge.world.core.v1

; EXACT REPLAY — its OWN clock domain into a relay chain and a Door; the runner reduces this world TWICE and
; the build refuses unless both runs produce identical Film hashes. er_a is Part V's router in the chain.
[pulser:er_clock](every 2){sig_out}
[relay:er_a]{sig_in, sig_out}
[relay:er_b]{sig_in, sig_out}
[door:er_player]{sig_in}

[er_clock] --sig--> [er_a]
[er_a] --sig--> [er_b]
[er_b] --sig--> [er_player]
