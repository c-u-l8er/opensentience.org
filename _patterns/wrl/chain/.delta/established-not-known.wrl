profile forge.world.core.v1

; ESTABLISHED, NOT KNOWN — an observation (en_in) passes through en_established before it can act on the
; Door. en_established is Part V's router: chapters 27 and 28 draw from it.
[relay:en_in]{sig_in, sig_out}
[relay:en_established]{sig_in, sig_out}
[door:en_act]{sig_in}

[en_in] --sig--> [en_established]
[en_established] --sig--> [en_act]

; TEST BENCH — drives this chapter's entry alone; the chain replaces it with a wire from an earlier chapter
[pulser:en_bench](every 1){sig_out}
[en_bench] --sig--> [en_in]
